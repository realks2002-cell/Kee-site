# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (마이그레이션용 — 본관 정규화)
GEMINI_API_KEY=

# 카카오맵 (지역 통계)
NEXT_PUBLIC_KAKAO_MAPS_KEY=

# 이메일 (위원회 알림)
RESEND_API_KEY=

# 로컬 Supabase Postgres (supabase start 후)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# 으뜸족보 분석용 MySQL (docker compose -f docker/uttom-mysql.yml up)
UTTOM_MYSQL_URL=mysql://root:local@localhost:3306/uttom_jokbo
